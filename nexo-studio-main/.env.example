# Copie para um arquivo local .env se seu ambiente carregar esse formato.
# Não versione segredos reais no Git.
NEXO_SECRET_KEY=gere-uma-chave-aleatoria-longa-e-privada
NEXO_DEBUG=1
NEXO_ALLOWED_HOSTS=localhost,127.0.0.1
# Em produção, configure HTTPS antes de habilitar redirecionamento/HSTS.
NEXO_SECURE_SSL_REDIRECT=1
NEXO_HSTS_SECONDS=0
# Para Codespaces/HTTPS, informe as origens completas separadas por vírgula.
NEXO_CSRF_TRUSTED_ORIGINS=
